<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.portfolio.board.mapper.BoardMapper">

    <!-- DB 컬럼(snake_case) ↔ VO 필드(camelCase) 매핑 -->
    <resultMap id="boardResultMap" type="com.portfolio.board.vo.BoardVO">
        <id     property="boardNo"   column="board_no" />
        <result property="title"     column="title" />
        <result property="content"   column="content" />
        <result property="writer"    column="writer" />
        <result property="viewCnt"   column="view_cnt" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <select id="selectList" resultMap="boardResultMap">
        SELECT board_no, title, writer, view_cnt, created_at, updated_at
        FROM board
        <where>
            <if test="keyword != null and keyword != ''">
                title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY board_no DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*)
        FROM board
        <where>
            <if test="keyword != null and keyword != ''">
                title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <select id="selectOne" resultMap="boardResultMap">
        SELECT board_no, title, content, writer, view_cnt, created_at, updated_at
        FROM board
        WHERE board_no = #{boardNo}
    </select>

    <update id="increaseViewCnt">
        UPDATE board
        SET view_cnt = view_cnt + 1
        WHERE board_no = #{boardNo}
    </update>

    <!--
      MariaDB: AUTO_INCREMENT 사용 → useGeneratedKeys로 채번된 PK를 board.boardNo에 자동 반영
      Oracle로 전환 시에는 아래 주석 처리된 <selectKey> 방식으로 교체 (board_seq 사용)
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="boardNo">
        INSERT INTO board (title, content, writer, view_cnt, created_at)
        VALUES (#{title}, #{content}, #{writer}, 0, NOW())
    </insert>

    <!--
    <insert id="insert">
        <selectKey keyProperty="boardNo" resultType="long" order="BEFORE">
            SELECT board_seq.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO board (board_no, title, content, writer, view_cnt, created_at)
        VALUES (#{boardNo}, #{title}, #{content}, #{writer}, 0, SYSDATE)
    </insert>
    -->

    <update id="update">
        UPDATE board
        SET title = #{title},
            content = #{content},
            updated_at = NOW()
        WHERE board_no = #{boardNo}
    </update>

    <delete id="delete">
        DELETE FROM board
        WHERE board_no = #{boardNo}
    </delete>

</mapper>
